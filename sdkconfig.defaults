# CPU: 240 MHz
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Flash: 16 MB, DIO, 80 MHz
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# PSRAM: octal, 80 MHz (ESP32-S3 on-board PSRAM)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
# Allocations <= 16 KB stay in internal SRAM; larger go to PSRAM
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384

# Cache: 32 KB I-cache + 32 KB D-cache for maximum throughput
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_32B=y

# SPI master driver in IRAM so DMA ISR doesn't stall on cache misses
CONFIG_SPI_MASTER_IN_IRAM=y
CONFIG_SPI_MASTER_ISR_IN_IRAM=y

# FreeRTOS: 1 kHz tick for accurate 1 ms sleeps / timing
CONFIG_FREERTOS_HZ=1000
# Main task: large stack (3-D math + particle array), pinned to Core 1
# Core 0 handles FreeRTOS idle / timer tasks; Core 1 runs our render loop.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=32768
CONFIG_ESP_MAIN_TASK_CORE_ID=1

# Log
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Watchdog: give the tight render loop 30 s before panic
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
